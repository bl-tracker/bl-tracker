# Nakili faili hii kuwa `.env` kisha jaza maadili yako.
# Copy this file to `.env` and fill in your values.

# --- Telegram (lazima kwa summary) ---
# Pata token kutoka @BotFather. Pata chat id kutoka @userinfobot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Lugha ya ujumbe wa Telegram: sw au en
NOTIFY_LANG=sw

# --- Usalama ---
# Neno la siri linalolinda mlango wa /tasks/notify (cron). Tengeneza lolote refu.
NOTIFY_TOKEN=badilisha-hii-iwe-siri-ndefu
# Siri ya Flask sessions/flash.
SECRET_KEY=badilisha-hii-pia

# --- Scheduler ---
# 1 = endesha kazi ya kila saa 3 ndani ya app (kwa seva zisizolala).
# 0 = tumia cron ya nje (inashauriwa kwa tier ya bure). Tazama README.
RUN_SCHEDULER=0

# --- Database (hiari) ---
# Ukiacha wazi, inatumia SQLite (faili bl_tracker.db).
# DB_PATH=/data/bl_tracker.db
